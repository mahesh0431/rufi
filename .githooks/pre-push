#!/bin/sh
# main changes only through pull requests (GitHub Free can't protect a private repo's branches).
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: pushing to main is blocked. Open a pull request instead." >&2
    exit 1
  fi
done
exit 0
