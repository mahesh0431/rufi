                      "minLength": 1,
                      "maxLength": 100,
                      "description": "The medicine use's id, from get_overview; not when adding."
                    },
                    "source": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000,
                      "description": "The user's own words this change rests on, copied exactly from one of their messages in this conversation (a sentence or part of one)."
                    },
                    "fields": {
