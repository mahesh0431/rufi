                      "enum": [
                        "medicine_use"
                      ]
                    },
                    "action": {
                      "type": "string",
                      "enum": [
                        "add",
                        "change",
                        "remove",
                        "restore"
                      ]
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$",
                      "minLength": 1,
                      "maxLength": 100,
                      "description": "The medicine use's id, from get_overview; not when adding."
                    },
                    "source": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000,
                      "description": "The user's own words this change rests on, copied exactly from one of their messages in this chat (a sentence or part of one)."
                    },
                    "fields": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "$ref": "#/$defs/Text"
                        },
                        "strength": {
                          "anyOf": [
                            {
