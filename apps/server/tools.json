{
  "tools": [
    {
      "name": "rufi.get_overview",
      "description": "The active person's health record in Rufi at a glance: their name, how many documents and reports they have, their current test results exactly as printed (id, test, value, unit, reference range, flag, method or context, measured date at the precision known), their other records by kind (medicine uses, prescriptions, symptoms, conditions, allergies, care events, \"none known\" statements, follow-ups; each with its id and fields as save_changes takes them), and their latest saves with what each changed. At most 20 results, newest measured first, undated last; at most 50 records of a kind, newest first; the latest 5 saves, newest first. An amended result replaces the one it corrects and says \"amended\": true. Removed records aren't shown. Takes no input: Rufi chooses the person, not you.",
      "callers": "both",
      "readOnly": true,
      "destructive": false,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "examples": [
        {}
      ]
    },
    {
      "name": "rufi.get_records",
      "description": "The active person's records of one kind (medicine_use, prescription, symptom, condition, allergy, result, care_event, none_known, follow_up), as stored: each with its id and fields as save_changes takes them, also the records removed from the record (\"removed\": true) and results replaced by an amended one (\"replaced_by\": the amended result's id). Newest first, undated last. With from or to, only records dated in that period: medicine_use by started, prescription by issued, symptom by onset, condition by recognised, allergy by reacted, result by measured, care_event by date, none_known by asserted, follow_up by due. A record dated at a lower precision is read when its year or month overlaps the period (\"2026\" is in from 2026-03); a record with no date is read only without from and to. At most 200 records and 32 KB of records (as UTF-8 JSON) come back. When a cap leaves records out, the answer says \"complete\": false and \"capped\": narrow the dates and read again. Read only: nothing changes. Count, compare and find trends in the records yourself. Rufi chooses the person, not you.",
      "callers": "model",
      "readOnly": true,
      "destructive": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "medicine_use",
              "prescription",
              "symptom",
              "condition",
              "allergy",
              "result",
              "care_event",
              "none_known",
              "follow_up"
            ],
            "description": "The kind of record, as save_changes names it."
          },
          "from": {
            "type": "string",
            "description": "The earliest date to read, YYYY, YYYY-MM or YYYY-MM-DD; leave it out for no start."
          },
          "to": {
            "type": "string",
            "description": "The latest date to read, YYYY, YYYY-MM or YYYY-MM-DD; leave it out for no end."
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false
      },
      "examples": [
        {
          "kind": "result",
          "from": "2024"
        },
        {
          "kind": "symptom",
          "from": "2026-01",
          "to": "2026-06"
        }
      ]
    },
    {
      "name": "rufi.get_documents",
      "description": "The active person's documents (lab reports, prescriptions, letters they added), read only. Without document: the list, newest first, each with its id, when it was added, its files and pages, and its status (\"not_read\": not read yet). With document: its pages. With document and page: that page as an image, with the page's own text when the PDF has some (use it for exact characters); a photo or a scan is the image alone. At most 50 documents or 100 pages come back; when there are more, the answer has \"next\": pass it as after to read on. Documents are not the record: nothing in them counts as saved. Rufi chooses the person, not you.",
      "callers": "model",
      "readOnly": true,
      "destructive": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "document": {
            "type": "string",
            "description": "A document's id, from the list. Leave it out for the list."
          },
          "page": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "A page of that document, 1, 2, 3...: you get the page's image and its own text when it has some."
          },
          "after": {
            "type": "string",
            "description": "The `next` of the previous answer, to read on."
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {},
        {
          "document": "01a12345-0000-7000-8000-000000000000"
        },
        {
          "document": "01a12345-0000-7000-8000-000000000000",
          "page": 1
        }
      ]
    },
    {
      "name": "rufi.read_chat",
      "description": "Earlier parts of this chat, newest first. Each entry's kind is \"message\" (the user's), \"steer\" (the user's, sent while you were replying), \"reply\" (yours), \"activity\" (one thing you did: a title and one short detail, never its output), \"receipt\" (Rufi's line for a save to the record: what was saved) or \"event\" (Rufi's own line about something that happened, never the user's words). \"at\" is when it was written. At most 50 entries a page; pass the page's next_before to read further back. Rufi chooses the chat, not you.",
      "callers": "model",
      "readOnly": true,
      "destructive": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "before": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "Read entries before this position: the `next_before` of the previous page."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "How many entries, 1 to 50; 20 when left out."
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {},
        {
          "before": 41,
          "limit": 20
        }
      ]
    },
    {
      "name": "rufi.save_changes",
      "description": "Saves changes to the active person's record, all or nothing, after the user clearly said yes to exactly these changes in this chat. Each change is one record: add one, change the fields given (the rest stay as they are), remove one (it stays in history) or restore a removed one; ids come from get_overview. Give only what the user said: a field they didn't give stays out, and a date needs their own words from the source message. source is the user's own words the change rests on, copied from their message. At most 20 changes. Rufi refuses a save with any problem and says each one; nothing is saved then. On success Rufi adds its own receipt to the chat and returns it; the same call again returns the same receipt. Never say something was saved without this tool's answer.",
      "callers": "model",
      "readOnly": false,
      "destructive": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "changes": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
