                            {
                              "$ref": "#/$defs/Text"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "purpose": {
                          "anyOf": [
                            {
                              "$ref": "#/$defs/Text"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "current",
                            "paused",
                            "stopped",
                            "completed",
                            "unknown"
                          ]
