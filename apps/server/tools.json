{
  "tools": [
    {
      "name": "rufi.get_overview",
      "description": "The active person's health record in Rufi at a glance: their name, how many documents and reports they have, their current test results exactly as printed (id, test, value, unit, reference range, flag, method or context, measured date at the precision known), their other records by kind (medicine uses, prescriptions, symptoms, conditions, allergies, care events, \"none known\" statements, follow-ups; each with its id and fields as save_changes takes them), and their latest saves with what each changed. At most 20 results, newest measured first, undated last; at most 50 records of a kind, newest first; the latest 5 saves, newest first. An amended result replaces the one it corrects and says \"amended\": true. Removed records aren't shown. Takes no input: Rufi chooses the person, not you.",
      "callers": "both",
      "readOnly": true,
      "destructive": false,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "examples": [
        {}
      ]
    },
    {
      "name": "rufi.read_conversation",
      "description": "Earlier parts of this conversation, newest first. Each entry's kind is \"message\" (the user's), \"steer\" (the user's, sent while you were replying), \"reply\" (yours), \"activity\" (one thing you did: a title and one short detail, never its output) or \"receipt\" (Rufi's line for a save to the record: what was saved). \"at\" is when it was written. At most 50 entries a page; pass the page's next_before to read further back. Rufi chooses the conversation, not you.",
      "callers": "model",
      "readOnly": true,
      "destructive": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "before": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "Read entries before this position: the `next_before` of the previous page."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "How many entries, 1 to 50; 20 when left out."
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {},
        {
          "before": 41,
          "limit": 20
        }
      ]
    },
    {
      "name": "rufi.save_changes",
      "description": "Saves changes to the active person's record, all or nothing, after the user clearly said yes to exactly these changes in this conversation. Each change is one record: add one, change the fields given (the rest stay as they are), remove one (it stays in history) or restore a removed one; ids come from get_overview. Give only what the user said: a field they didn't give stays out, and a date needs their own words from the source message. source is the user's own words the change rests on, copied from their message. At most 20 changes. Rufi refuses a save with any problem and says each one; nothing is saved then. On success Rufi adds its own receipt line to the conversation and returns it; the same call again returns the same receipt. Never say something was saved without this tool's answer.",
      "callers": "model",
      "readOnly": false,
      "destructive": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "changes": {
            "type": "array",
