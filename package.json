{
  "name": "rufi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "test \"$(git config --get core.hooksPath)\" = .githooks || git config core.hooksPath .githooks",
    "format": "oxfmt",
    "lint": "oxlint --type-aware --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "pnpm --filter @rufi/web build && node apps/server/src/cli/main.ts start",
    "desktop": "pnpm --filter @rufi/web build && node apps/desktop/scripts/desktop.ts",
    "demo": "pnpm --filter @rufi/web build && node apps/server/scripts/demo.ts",
    "rufi": "node apps/server/src/cli/main.ts",
    "codex:types": "node apps/server/scripts/codex-types.ts",
    "tools:json": "node apps/server/scripts/tools-json.ts",
    "check:quick": "oxfmt --check && oxlint --type-aware --deny-warnings && tsc --noEmit && tsc --noEmit -p apps/web && knip",
    "check": "pnpm check:quick && pnpm --filter @rufi/web build && vitest run && playwright test",
    "db:types": "node apps/server/scripts/db-types.ts",
    "smoke": "node apps/server/scripts/smoke.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "fflate": "0.8.3",
    "knip": "6.42.1",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "packageManager": "pnpm@12.8.1",
  "knip": {
    "workspaces": {
      "apps/server": {
        "entry": [
          "scripts/*.ts",
          "tests/core-process.ts",
          "tests/save-process.ts"
        ],
        "ignore": [
          "src/agent/codex/protocol/**"
        ]
      },
      "apps/desktop": {
        "entry": [
          "e2e/fakes.ts"
        ]
      },
      "apps/web": {
        "entry": [
          "src/diagram/frame.ts"
        ]
      }
    }
  }
}
