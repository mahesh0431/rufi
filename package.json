{
  "name": "rufi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "test \"$(git config --get core.hooksPath)\" = .githooks || git config core.hooksPath .githooks",
    "format": "oxfmt",
    "lint": "oxlint --type-aware --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "rufi": "node apps/server/src/cli/main.ts",
    "codex:types": "node apps/server/scripts/codex-types.ts",
    "tools:json": "node apps/server/scripts/tools-json.ts",
    "check": "oxfmt --check && oxlint --type-aware --deny-warnings && tsc --noEmit && vitest run && knip"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "knip": "6.38.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "packageManager": "pnpm@12.8.1",
  "knip": {
    "workspaces": {
      "apps/server": {
        "entry": [
          "scripts/*.ts"
        ],
        "ignore": [
          "src/agent/codex/protocol/**"
        ]
      }
    }
  }
}
