{
  "name": "rufi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "prettier --check . && eslint . && tsc --noEmit && vitest run && knip"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "jiti": "2.7.0",
    "knip": "6.38.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2"
  }
}
